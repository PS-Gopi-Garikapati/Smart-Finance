# ==============================================================================
# SMART FINANCE AGENT – ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and adjust the values according to your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ollama LLM Service Configuration
# ------------------------------------------------------------------------------
# Host URL for local or containerized Ollama instance
# For native local run: http://localhost:11434
# For Docker run:       http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434

# Target LLM model name (must be pulled in Ollama, e.g., 'ollama pull qwen2.5:7b')
OLLAMA_MODEL=qwen2.5:7b

# ------------------------------------------------------------------------------
# 2. SQLite Database & Connection Pool Configuration
# ------------------------------------------------------------------------------
# Path to SQLite database file
DB_PATH=database/finance.db

# Maximum number of pooled SQLite connections
DB_POOL_SIZE=10

# Timeout (in seconds) when acquiring a pooled database connection
DB_POOL_TIMEOUT=30.0

# ------------------------------------------------------------------------------
# 3. FastAPI Web Server & Networking
# ------------------------------------------------------------------------------
# Server listening port
PORT=8000

# Server listening host IP (0.0.0.0 to bind all network interfaces)
HOST=0.0.0.0

# Allowed CORS origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# Rate limit for /api/ask endpoint (max requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=30

# Enable auto-reload for local development (set to true for dev, false for production/docker)
RELOAD=false

# ------------------------------------------------------------------------------
# 4. Agent Date & Timeframe Anchor
# ------------------------------------------------------------------------------
# Optional reference date (YYYY-MM-DD) for deterministic tests or demos.
# When omitted, relative date expressions use today's date.
# CURRENT_DATE=2026-09-15

